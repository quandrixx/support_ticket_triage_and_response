{
  "name": "Triage Crew",
  "agents": ["ticket_classifier"],
  "tasks": [
    {
      "name": "triage_task",
      "description": "Triage the following support ticket in a single pass and produce a structured triage result.\n\nDetermine all of the following:\n- category: one of bug, billing, how_to, account, or other.\n- urgency: a score from 1 (highest priority) to 5 (lowest), based on tone, wording, and business impact.\n- requires_human: true if the ticket needs human review before an automated response is sent — e.g. it mentions a refund, a legal or contractual issue, account suspension, or the customer is clearly upset or threatening to leave.\n- summary: a brief summary of the ticket and your reasoning for the category, urgency, and human-review decision.\n\nTicket:\n{ticket_text}",
      "expected_output": "A structured triage result with category, urgency (1-5), requires_human, and a short summary explaining the reasoning.",
      "agent": "ticket_classifier",
      "output_pydantic": { "python": "models.TriageResult" }
    }
  ],
  "process": "sequential"
}
